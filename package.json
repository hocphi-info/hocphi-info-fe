{
  "name": "hocphi-info-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare build && wrangler deploy",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "openapi-typescript \"${OPENAPI_SRC:-https://raw.githubusercontent.com/hocphi-info/hocphi-info-be/main/openapi.json}\" -o src/types/api.gen.ts && prettier --write src/types/api.gen.ts",
    "format": "prettier --write .",
    "prepare": "husky",
    "blog:build": "node scripts/blog/build.mjs",
    "blog:check": "node scripts/blog/build.mjs --check-only",
    "predev": "node scripts/blog/build.mjs --drafts --no-og --no-links",
    "pretypecheck": "node scripts/blog/build.mjs --no-og --no-links",
    "prebuild": "node scripts/blog/build.mjs",
    "test:blog": "node --test \"scripts/blog/**/*.test.mjs\""
  },
  "lint-staged": {
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "image-size": "^2.0.4",
    "lint-staged": "^16.4.0",
    "markdown-it": "^15.0.2",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6",
    "satori": "^0.47.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.129.0"
  }
}
